---
import { contacto } from '../data/contacto.js';

const enlaceWhatsapp = contacto.whatsapp
  ? `https://wa.me/${contacto.whatsapp}?text=${encodeURIComponent(contacto.whatsappMensaje)}`
  : null;
---

<section id="redes" class="redes">
  <div class="redes-encabezado">
    <h2>Seguinos en redes</h2>
    <p>Novedades e información para comerciantes, pymes y empresas de Zárate, en un solo lugar.</p>
  </div>
  <ul class="redes-lista">
    {enlaceWhatsapp && (
      <li>
        <a class="red-fila" href={enlaceWhatsapp} target="_blank" rel="noopener noreferrer" aria-label="Escribinos por WhatsApp">
          <svg class="red-icono" width="32" height="32" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
          <span class="red-nombre">WhatsApp</span>
          <span class="red-usuario">Escribinos un mensaje</span>
          <svg class="red-flecha" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 17L17 7M8 7h9v9"/></svg>
        </a>
      </li>
    )}
    {contacto.email && (
      <li>
        <a class="red-fila" href={`mailto:${contacto.email}`} aria-label={`Escribinos por email a ${contacto.email}`}>
          <svg class="red-icono red-icono-trazo" width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
          <span class="red-nombre">Email</span>
          <span class="red-usuario">{contacto.email}</span>
          <svg class="red-flecha" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 17L17 7M8 7h9v9"/></svg>
        </a>
      </li>
    )}
    <li>
      <a class="red-fila" href="https://www.instagram.com/centrodelcomercio/" target="_blank" rel="noopener noreferrer" aria-label="Instagram: @centrodelcomercio">
        <svg class="red-icono red-icono-trazo" width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><path d="M17.5 6.5h.01"/></svg>
        <span class="red-nombre">Instagram</span>
        <span class="red-usuario">@centrodelcomercio</span>
        <svg class="red-flecha" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 17L17 7M8 7h9v9"/></svg>
      </a>
    </li>
    <li>
      <a class="red-fila" href="https://x.com/cciz_oficial" target="_blank" rel="noopener noreferrer" aria-label="Twitter / X: @cciz_oficial">
        <svg class="red-icono" width="32" height="32" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.64 7.584H.47l8.6-9.835L0 1.154h7.594l5.243 6.932 6.064-6.933Zm-1.29 19.49h2.039L6.487 3.24H4.3l13.31 17.403Z"/></svg>
        <span class="red-nombre">X (Twitter)</span>
        <span class="red-usuario">@cciz_oficial</span>
        <svg class="red-flecha" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 17L17 7M8 7h9v9"/></svg>
      </a>
    </li>
    <li>
      <a class="red-fila" href="https://www.youtube.com/@CCIZ-Oficial" target="_blank" rel="noopener noreferrer" aria-label="YouTube: @CCIZ-Oficial">
        <svg class="red-icono" width="32" height="32" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill-rule="evenodd" d="M23 7a3 3 0 0 0-2-2c-2-.5-7-.5-9-.5S5 4.5 3 5a3 3 0 0 0-2 2c-.5 2-.5 8 0 10a3 3 0 0 0 2 2c2 .5 7 .5 9 .5s7 0 9-.5a3 3 0 0 0 2-2c.5-2 .5-8 0-10ZM10 8.5v7l6-3.5-6-3.5Z"/></svg>
        <span class="red-nombre">YouTube</span>
        <span class="red-usuario">@CCIZ-Oficial</span>
        <svg class="red-flecha" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 17L17 7M8 7h9v9"/></svg>
      </a>
    </li>
    <li>
      <a class="red-fila" href="https://maps.app.goo.gl/pQNbhsViciNPWHnE9?g_st=iw" target="_blank" rel="noopener noreferrer" aria-label="Ubicación en Google Maps">
        <svg class="red-icono red-icono-trazo" width="32" height="32" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
        <span class="red-nombre">Ubicación</span>
        <span class="red-usuario">Ver en Google Maps</span>
        <svg class="red-flecha" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 17L17 7M8 7h9v9"/></svg>
      </a>
    </li>
  </ul>
  <!--
  <form class="contacto-form">
    <div class="form-grupo">
      <label for="nombre">Nombre</label>
      <input type="text" id="nombre" name="nombre" required>
    </div>
    <div class="form-grupo">
      <label for="apellido">Apellido</label>
      <input type="text" id="apellido" name="apellido" required>
    </div>
    <div class="form-grupo">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required>
    </div>
    <div class="form-grupo">
      <label for="mensaje">Mensaje</label>
      <textarea id="mensaje" name="mensaje" rows="5" required></textarea>
    </div>
    <button type="submit" class="btn-enviar">Enviar</button>
  </form>
  -->
</section>
