---
import { espacios } from '../data/espacios.js';
---

<section id="espacios" class="espacios">
  <h2>Espacios del Centro</h2>
  <ul class="espacios-lista">
    {espacios.map((espacio) => {
      const Etiqueta = espacio.enlace ? 'a' : 'div';
      return (
        <li>
          <Etiqueta class="espacio-fila" href={espacio.enlace ?? undefined}>
            <span class:list={['espacio-logo', { 'espacio-logo-sin-imagen': !espacio.logo }]}>
              {espacio.logo ? (
                <img src={espacio.logo} alt={`Logo de ${espacio.nombre}`} height="88" />
              ) : (
                <span class="espacio-logo-provisorio" aria-hidden="true">{espacio.iniciales}</span>
              )}
            </span>
            <span class="espacio-texto">
              <h3>{espacio.nombre}</h3>
              {espacio.descripcion && <p class="espacio-descripcion">{espacio.descripcion}</p>}
            </span>
            {espacio.enlace && (
              <svg class="espacio-flecha" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
            )}
          </Etiqueta>
        </li>
      );
    })}
  </ul>
</section>
