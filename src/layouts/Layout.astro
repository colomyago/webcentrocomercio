---
import '../styles/global.css';
import Flotantes from '../components/Flotantes.astro';
import { contacto } from '../data/contacto.js';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Centro Del Comercio e Industrias de Zárate',
  description = 'Entidad civil sin fines de lucro que reúne a comerciantes, pymes e industrias de Zárate y la región. Asesoramiento, representación y servicios para tu negocio.',
} = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site).href;
const imagen = new URL('/og-image.png', Astro.site).href;

const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Centro Del Comercio e Industrias de Zárate',
  url: Astro.site?.href,
  logo: new URL('/icon-512.png', Astro.site).href,
  description,
  areaServed: 'Zárate, Buenos Aires, Argentina',
  sameAs: [
    'https://www.instagram.com/centrodelcomercio/',
    'https://x.com/cciz_oficial',
    'https://www.youtube.com/@CCIZ-Oficial',
  ],
  ...(contacto.email ? { email: contacto.email } : {}),
  ...(contacto.whatsapp ? { telephone: `+${contacto.whatsapp}` } : {}),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#B01C22" />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="Centro Del Comercio e Industrias de Zárate" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logo del Centro Del Comercio e Industrias de Zárate" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,500..900&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <slot />
    <Flotantes />
    <script>
      import '../scripts/main.js';
    </script>
  </body>
</html>
