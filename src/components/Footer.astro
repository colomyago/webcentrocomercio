---
import { contacto } from '../data/contacto.js';

const anio = new Date().getFullYear();
const hayAtencion = contacto.horario || contacto.telefono;
---

<footer>
  <div class="footer-marca">
    <span class="footer-placa"><img src="/logo-centro-chico.webp" alt="" width="30" height="34" /></span>
    <p>Centro Del Comercio e Industrias de Zárate</p>
  </div>
  {(contacto.direccion || hayAtencion) && (
    <dl class="footer-datos">
      {contacto.direccion && (
        <div>
          <dt>Sede</dt>
          <dd>{contacto.direccion}<br />Zárate, Buenos Aires</dd>
        </div>
      )}
      {hayAtencion && (
        <div>
          <dt>Atención</dt>
          {contacto.horario && <dd>{contacto.horario}</dd>}
          {contacto.telefono && <dd>{contacto.telefono}</dd>}
        </div>
      )}
    </dl>
  )}
  <nav class="footer-links" aria-label="Secciones">
    <a href="#nosotros">Nosotros</a>
    <a href="#que-hacemos">Qué hacemos</a>
    <a href="#espacios">Espacios</a>
    <a href="#redes">Redes</a>
    <a href="#inicio">Volver arriba</a>
  </nav>
  <p class="footer-copy">&copy; {anio} · Entidad civil sin fines de lucro</p>
</footer>
